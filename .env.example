# Lumen Lens Environment Configuration
# Copy to .env and fill in values

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=lumen-lens
APP_VERSION=1.0.0

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL for production, SQLite for dev)
# DATABASE_URL=postgresql+asyncpg://lumen_lens:changeme@localhost:5432/lumen_lens
DATABASE_URL=sqlite+aiosqlite:///./lumen_lens.db

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak OIDC
OIDC_ENABLED=true
OIDC_ISSUER_URL=http://localhost:8080/realms/lumen-lens
OIDC_CLIENT_ID=lumen-lens-backend
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=lumen-lens-api
OIDC_JWKS_URL=

# LLM Providers (optional - for AI explanations)
# Providers: openai-compatible, anthropic, gemini, ollama
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Demo Mode (local only - REFUSED in production)
DEMO_MODE=false

# PostgreSQL (for Docker Compose)
POSTGRES_PASSWORD=changeme

# Keycloak (for Docker Compose)
KEYCLOAK_ADMIN_PASSWORD=changeme